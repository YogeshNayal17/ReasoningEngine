# Copy this file to .env and fill in your real key when you have one.
#
# While USE_MOCK=True (the default), OPENAI_API_KEY is never read and no
# API calls are made — /analyze returns fixed placeholder data at zero
# cost. Set USE_MOCK=False once a real key is in place to get actual
# OpenAI-backed analysis.
OPENAI_API_KEY=
USE_MOCK=True
OPENAI_MODEL=gpt-4o-mini
