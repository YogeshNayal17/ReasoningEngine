# Copy this file to .env and fill in the values for your chosen LLM provider.
# USE_MOCK=True returns fixed placeholder data with no LLM calls.
USE_MOCK=False

# ── Option 1: Local Ollama (free, slower on CPU) ──────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# ── Option 2: Groq (free tier, fast) ─────────────────────────────────────────
# Sign up at console.groq.com → API Keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=gsk_your_key_here

# ── Option 3: OpenAI ──────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk_your_key_here
